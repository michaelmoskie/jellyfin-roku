import "pkg:/source/api/baserequest.bs"
import "pkg:/source/utils/remoteSubtitles.bs"
import "pkg:/source/enums/MediaPlaybackState.bs"
import "pkg:/source/enums/SubtitleSelection.bs"
import "pkg:/source/enums/TaskControl.bs"
import "pkg:/source/enums/TimerControl.bs"
import "pkg:/source/enums/TransportCommand.bs"
import "pkg:/source/enums/TransportStatus.bs"
import "pkg:/source/enums/VideoControl.bs"

const STILL_WATCHING_POPUP_TIMER_SECONDS = 60


' Play Audio
sub CreateAudioPlayerView(showAudioPlayerView = false as boolean)
    currentItem = m.global.queueManager.callFunc("getCurrentItem")
    if not isValid(currentItem)
        stopLoadingSpinner()
        return
    end if

    audioItemChanged = m.global.audioPlayer.id <> currentItem.id
    if audioItemChanged
        m.global.audioPlayer.id = invalid
        m.global.audioPlayer.id = currentItem.id
    end if

    ' Only bypass creating an audio player view if the current queue is only audio
    if m.global.queueManager.callFunc("getQueueUniqueTypes").count() = 1
        if audioMiniPlayerIsVisible(m.top)
            if not showAudioPlayerView
                if not audioItemChanged then stopLoadingSpinner()
                return
            end if
            m.audioMiniPlayer.callFunc("setVisible", false)
        end if
    end if

    m.view = CreateObject("roSGNode", "AudioPlayerView")
    m.view.observeField("state", "onStateChange")
    m.global.sceneManager.callFunc("pushScene", m.view)
end sub

' Play Audio
sub JumpIntoAudioPlayerView()
    m.view = CreateObject("roSGNode", "AudioPlayerView")

    ' Hide the mini player
    if audioMiniPlayerIsVisible(m.view)
        m.audioMiniPlayer.callFunc("setVisible", false)
    end if

    m.view.returnOnStop = true
    m.global.sceneManager.callFunc("pushScene", m.view)
end sub

' Play Video
sub CreateVideoPlayerView()
    m.playbackData = {}
    m.selectedSubtitle = {}

    ' Hide the mini player if needed
    if audioMiniPlayerIsVisible(m.top)
        m.audioMiniPlayer.callFunc("setVisible", false)
    end if

    ' Stop active audio and release its media content before creating the video player
    if inArray([MediaPlaybackState.PLAYING, MediaPlaybackState.PAUSED, MediaPlaybackState.BUFFERING], m.global.audioPlayer.state)
        m.global.audioPlayer.control = VideoControl.STOP
        m.global.audioPlayer.content = invalid
    end if

    currentItem = m.global.queueManager.callFunc("getCurrentItem")

    ' If the user has set a preferred audio track index, use it
    preferredAudioTrackIndex = m.global.queueManager.callFunc("getPreferredAudioTrackIndex")
    if preferredAudioTrackIndex < 0 then preferredAudioTrackIndex = 0

    selectedAudioIndex = preferredAudioTrackIndex
    if isValid(currentItem.selectedAudioStreamIndex) and currentItem.selectedAudioStreamIndex >= 0
        selectedAudioIndex = currentItem.selectedAudioStreamIndex
    end if

    m.global.queueManager.callFunc("setSelectedAudioStreamIndex", selectedAudioIndex)

    m.view = CreateObject("roSGNode", "VideoPlayerView")
    m.view.observeField("state", "onStateChange")
    m.view.observeField("nowPlayingMetadata", "onNowPlayingMetadata")
    m.view.observeField("selectPlaybackInfoPressed", "onSelectPlaybackInfoPressed")
    m.view.observeField("selectSubtitlePressed", "onSelectSubtitlePressed")
    m.view.observeField("selectAudioPressed", "onSelectAudioPressed")
    m.view.observeField("selectSpeedPressed", "onSelectSpeedPressed")

    ' Start VoiceInputTask to receive voice transport commands
    m.voiceInputTask = CreateObject("roSGNode", "VoiceInputTask")
    m.voiceInputTask.observeField("inputData", "onVoiceInputData")
    m.voiceInputTask.control = TaskControl.RUN

    mediaSourceId = currentItem.mediaSourceId

    if not isValid(mediaSourceId) or mediaSourceId = ""
        mediaSourceId = currentItem.id
    end if

    m.getPlaybackInfoTask = createObject("roSGNode", "GetPlaybackInfoTask")
    m.getPlaybackInfoTask.videoID = mediaSourceId

    itemServerData = getServerInfoFromItem(currentItem)
    if isValid(itemServerData)
        m.getPlaybackInfoTask.serverUrl = itemServerData.serverUrl
        m.getPlaybackInfoTask.serverUserId = itemServerData.userId
        m.getPlaybackInfoTask.serverAuthToken = itemServerData.authToken
    end if

    m.getPlaybackInfoTask.observeField("data", "onPlaybackInfoLoaded")

    m.global.sceneManager.callFunc("pushScene", m.view)
end sub

' -----------------
' Event Handlers
' -----------------


sub onSelectAudioPressed()
    if not isValidAndNotEmpty(m.view.fullAudioData) then return

    preferredAudioTrackName = m.global.queueManager.callFunc("getPreferredAudioTrackName")

    currentItem = m.global.queueManager.callFunc("getCurrentItem")
    selectedAudioIndex = m.view.audioIndex
    if not isValid(selectedAudioIndex) or selectedAudioIndex < 0
        if isValid(currentItem.selectedAudioStreamIndex)
            selectedAudioIndex = currentItem.selectedAudioStreamIndex
        end if
    end if

    audioTracks = []

    for each item in m.view.fullAudioData
        audioTrack = {
            "Title": item.DisplayTitle,
            "StreamIndex": item.Index,
            "RokuTrackName": item.RokuTrackName,
            "Language": item.Language,
            "Codec": item.Codec,
            "Channels": item.Channels,
            "Selected": false
        }

        if isStringEqual(preferredAudioTrackName, string.EMPTY)
            if selectedAudioIndex = item.Index
                audioTrack.Selected = true
            end if
        else
            if isStringEqual(item.RokuTrackName, preferredAudioTrackName)
                audioTrack.Selected = true
            end if
        end if

        audioTracks.push(audioTrack)
    end for

    m.audioSelector = m.view.findNode("audioSelector")
    m.audioSelector.audioTracks = audioTracks
    m.audioSelector.visible = true
    m.audioSelector.setFocus(true)
    m.audioSelector.observeField("audioStreamIndex", "onAudioSelectorIndexChanged")
    m.audioSelector.observeField("visible", "onAudioSelectorVisibleChanged")
end sub

sub onSelectSubtitlePressed()
    subtitleTracks = []

    subtitleTracks.push({
        "Title": "None",
        "StreamIndex": SubtitleSelection.NONE,
        "Selected": false,
        "json": {
            "Index": SubtitleSelection.NONE,
            "IsExternal": false,
            "IsEncoded": false,
            "Track": {
                "description": "None",
                "TrackName": ""
            }
        }
    })

    if isValidAndNotEmpty(m.view.fullSubtitleData)
        for each item in m.view.fullSubtitleData
            isSelected = false

            if m.view.selectedSubtitle <> SubtitleSelection.NONE
                if item.index = m.view.selectedSubtitle
                    isSelected = true
                end if
            else
                availableSubtitleTrackIndex = availSubtitleTrackIdx(item.track.TrackName)
                if availableSubtitleTrackIndex <> SubtitleSelection.NONE
                    subtitleFullTrackName = m.view.availableSubtitleTracks[availableSubtitleTrackIndex].TrackName
                    if subtitleFullTrackName = m.view.subtitleTrack
                        isSelected = true
                    end if
                end if
            end if

            subtitleTrack = {
                "Title": item.Track.description,
                "StreamIndex": item.index,
                "Selected": isSelected,
                "json": {
                    "Index": item.index,
                    "IsExternal": item.LookupCI("IsExternal"),
                    "IsEncoded": item.LookupCI("IsEncoded"),
                    "Language": chainLookupReturn(item, "Track.Language", ""),
                    "IsForced": item.LookupCI("IsForced"),
                    "Track": item.Track
                }
            }

            subtitleTracks.push(subtitleTrack)
        end for
    end if

    m.subtitleSelector = m.view.findNode("subtitleSelector")
    m.subtitleSelector.subtitleTracks = subtitleTracks
    m.subtitleSelector.visible = true
    m.subtitleSelector.setFocus(true)
    m.subtitleSelector.observeField("subtitleStream", "onSubtitleSelectorStreamChanged")
    m.subtitleSelector.observeField("visible", "onSubtitleSelectorVisibleChanged")
    m.subtitleSelector.observeField("downloadRequested", "onSubtitleDownloadRequested")
end sub

sub onAudioSelectorIndexChanged()
    selectedIndex = m.audioSelector.audioStreamIndex

    selectedRokuTrackName = ""
    for each item in m.view.fullAudioData
        if item.Index = selectedIndex
            selectedRokuTrackName = item.RokuTrackName
            exit for
        end if
    end for

    m.global.queueManager.callFunc("setPreferredAudioTrackName", selectedRokuTrackName)

    for each audioTrack in m.view.availableAudioTracks
        if isStringEqual(audioTrack.LookupCI("name"), selectedRokuTrackName)
            m.global.queueManager.callFunc("setPreferredAudioTrackIndex", audioTrack.LookupCI("Track").toint())
            m.view.audioIndex = audioTrack.LookupCI("Track").toint()
            return
        end if
    end for

    m.global.queueManager.callFunc("setPreferredAudioTrackIndex", selectedIndex)
    m.view.audioIndex = selectedIndex
end sub

sub onAudioSelectorVisibleChanged()
    if not m.audioSelector.visible
        m.audioSelector.unobserveField("audioStreamIndex")
        m.view.setFocus(true)
    end if
end sub

sub onSubtitleSelectorStreamChanged()
    selectedNode = m.subtitleSelector.subtitleStream
    if not isValid(selectedNode) then return

    originalData = selectedNode.json
    if not isValid(originalData) then return

    m.selectedSubtitle = originalData

    if m.view.selectedSubtitle <> SubtitleSelection.NONE or m.selectedSubtitle.Index <> SubtitleSelection.NONE
        if m.view.selectedSubtitle = m.selectedSubtitle.Index then return
    end if

    m.playbackData = invalid

    for each item in m.view.fullSubtitleData
        if item.index = m.view.selectedSubtitle
            m.view.previousSubtitleWasEncoded = item.IsEncoded
            exit for
        end if
    end for

    if LCase(m.selectedSubtitle.Track.description) = "none"
        m.view.globalCaptionMode = "Off"
        m.view.subtitleTrack = ""

        if m.view.selectedSubtitle <> SubtitleSelection.NONE
            m.view.selectedSubtitle = SubtitleSelection.NONE
        end if

        m.global.queueManager.callFunc("setPreferredSubtitleTrack", m.selectedSubtitle)
        return
    end if

    if m.selectedSubtitle.IsEncoded
        m.view.globalCaptionMode = "Off"
    else
        m.view.globalCaptionMode = "On"

        availableSubtitleTrackIndex = availSubtitleTrackIdx(m.selectedSubtitle.Track.TrackName)
        if availableSubtitleTrackIndex = SubtitleSelection.NONE then return

        m.view.subtitleTrack = m.view.availableSubtitleTracks[availableSubtitleTrackIndex].TrackName
    end if

    m.global.queueManager.callFunc("setPreferredSubtitleTrack", m.selectedSubtitle)
    m.view.selectedSubtitle = m.selectedSubtitle.Index
end sub

sub onSubtitleDownloadRequested()
    if not m.subtitleSelector.downloadRequested then return

    m.subtitleSelector.downloadRequested = false

    currentItem = m.global.queueManager.callFunc("getCurrentItem")
    if not isValid(currentItem) then return
    if not isValidAndNotEmpty(currentItem.id) then return

    dialog = m.view.findNode("subtitleDownloadDialog")
    if not isValid(dialog) then return

    dialog.unobserveField("visible")
    dialog.observeField("visible", "onSubtitleDownloadDialogVisibleChanged")
    dialog.itemId = currentItem.id
    dialog.language = remoteSubtitles.LanguageFor(m.view.fullSubtitleData, m.view.selectedSubtitle, m.view.audioIndex)
    dialog.visible = true
    dialog.setFocus(true)
    dialog.callFunc("startSearch")
end sub

sub onSubtitleDownloadDialogVisibleChanged()
    dialog = m.view.findNode("subtitleDownloadDialog")
    if isValid(dialog) and not dialog.visible then m.view.setFocus(true)
end sub

sub onSubtitleSelectorVisibleChanged()
    if not m.subtitleSelector.visible
        m.subtitleSelector.unobserveField("subtitleStream")
        m.subtitleSelector.unobserveField("downloadRequested")
        m.view.setFocus(true)
    end if
end sub

' User requested playback info
sub onSelectPlaybackInfoPressed()
    ' Check if we already have playback info and show it in a popup
    if isValid(m.playbackData) and isValid(m.playbackData.playbackinfo)
        m.global.sceneManager.callFunc("standardDialog", tr("Playback Info"), m.playbackData.playbackinfo)
        return
    end if

    m.getPlaybackInfoTask.control = TaskControl.RUN
end sub

' The playback info task has returned data
sub onPlaybackInfoLoaded()
    m.playbackData = m.getPlaybackInfoTask.data

    ' Check if we have playback info and show it in a popup
    if isValid(m.playbackData) and isValid(m.playbackData.playbackinfo)
        m.global.sceneManager.callFunc("standardDialog", tr("Playback Info"), m.playbackData.playbackinfo)
    end if
end sub

' Playback state change event handlers
sub onStateChange()

    currentItem = m.global.queueManager.callFunc("getCurrentItem")
    if isValid(currentItem)
        itemServerData = getServerInfoFromItem(currentItem)
        if isValid(itemServerData)
        else
        end if
    end if

    ' If the state changed due to an error, we don't want to continue the queue
    if m.view.errorCode <> 0
        return
    end if

    if LCase(m.view.state) = "finished"
        if isValid(m.view.returnOnStop)
            if m.view.returnOnStop then return
        end if

        ' Close any open dialogs
        if m.global.sceneManager.callFunc("isDialogOpen")
            m.global.sceneManager.callFunc("dismissDialog")
        end if

        ' Check if user chose not to continue to next episode
        currentView = m.global.sceneManager.callFunc("getActiveScene")
        if isChainValid(currentView, "disableNextEpisodeAutoPlay")
            if currentView.disableNextEpisodeAutoPlay
                m.global.queueManager.callFunc("bypassNextPreferredAudioTrackIndexReset")
                m.global.queueManager.callFunc("clear")

                ' Stop VoiceInputTask when playback ends
                if isValid(m.voiceInputTask)
                    m.voiceInputTask.nowPlayingData = { title: string.EMPTY, contentType: string.EMPTY } ' clear before stopping
                    m.voiceInputTask.control = TaskControl.STOP
                end if

                ' Playback completed, return user to previous screen
                m.global.sceneManager.callFunc("popScene")
                m.global.audioPlayer.loopMode = ""
            end if
        end if

        ' If there is something next in the queue, play it
        if m.global.queueManager.callFunc("getPosition") < m.global.queueManager.callFunc("getCount") - 1
            stillwatchingPopupInactivityTime = chainLookupReturn(m.global.session, "user.settings.stillwatchingPopupInactivityTime", "0")
            if stillwatchingPopupInactivityTime <> "0"
                stillwatchingPopupInactivityTime = stillwatchingPopupInactivityTime.ToInt()
                m.deviceInfo = CreateObject("roDeviceInfo")

                if m.deviceInfo.TimeSinceLastKeypress() >= (stillwatchingPopupInactivityTime * 60)
                    m.stillWatchingTimer = createObject("roSGNode", "Timer")
                    m.stillWatchingTimer.repeat = false
                    m.stillWatchingTimer.duration = STILL_WATCHING_POPUP_TIMER_SECONDS
                    m.stillWatchingTimer.observeField("fire", "stillWatchingTimerComplete")
                    m.stillWatchingTimer.control = TimerControl.START

                    m.global.sceneManager.callFunc("optionDialog", "stillwatching", tr("Are You Still Watching?"), [tr("Playback will automatically stop in 1 minute if no buttons are pressed.")], [tr("Yes, continue"), tr("No, stop playback")], {})
                    return
                end if
            end if

            m.global.sceneManager.callFunc("clearPreviousScene")
            m.global.queueManager.callFunc("moveForward")
            m.global.queueManager.callFunc("playQueue")
            return
        end if

        episodeToShowAtFinish = string.EMPTY
        gotoNextEpisodeAfterCurrentEnds = m.global.session.user.settings["playback.showNextUpAfterFinish"] ?? false
        if gotoNextEpisodeAfterCurrentEnds
            episodeToShowAtFinish = m.global.queueManager.callFunc("getEpisodeToShowAtFinish")
        end if

        m.global.queueManager.callFunc("bypassNextPreferredAudioTrackIndexReset")
        m.global.queueManager.callFunc("clear")

        if isValidAndNotEmpty(episodeToShowAtFinish)
            m.global.queueManager.callFunc("setLastKnownItemID", episodeToShowAtFinish.LookupCI("id"))
        end if

        ' Stop VoiceInputTask when playback ends
        if isValid(m.voiceInputTask)
            m.voiceInputTask.nowPlayingData = { title: string.EMPTY, contentType: string.EMPTY } ' clear before stopping
            m.voiceInputTask.control = TaskControl.STOP
        end if

        ' Playback completed, return user to previous screen
        m.global.sceneManager.callFunc("popScene")
        m.global.audioPlayer.loopMode = ""
    else if LCase(m.view.state) = "stopped"
        if isValid(m.voiceInputTask)
            m.voiceInputTask.nowPlayingData = { title: string.EMPTY, contentType: string.EMPTY } ' clear before stopping
            m.voiceInputTask.control = TaskControl.STOP
        end if
    end if
end sub

sub stillWatchingTimerComplete()
    m.stillWatchingTimer.control = TimerControl.STOP

    ' Check if user pressed a button before the timer fired
    if m.deviceInfo.TimeSinceLastKeypress() <= STILL_WATCHING_POPUP_TIMER_SECONDS then return

    if m.global.sceneManager.callFunc("isDialogOpen")
        m.global.sceneManager.callFunc("dismissDialog")
    end if

    m.global.queueManager.callFunc("bypassNextPreferredAudioTrackIndexReset")
    m.global.queueManager.callFunc("clear")

    ' Stop VoiceInputTask when playback ends
    if isValid(m.voiceInputTask)
        m.voiceInputTask.nowPlayingData = { title: string.EMPTY, contentType: string.EMPTY } ' clear before stopping
        m.voiceInputTask.control = TaskControl.STOP
    end if
    m.global.sceneManager.callFunc("popScene")
end sub

' Roku translates the info provided in subtitleTracks into availableSubtitleTracks
' Including ignoring tracks, if they are not understood, thus making indexing unpredictable.
' This function translates between our internel selected subtitle index
' and the corresponding index in availableSubtitleTracks.
function availSubtitleTrackIdx(tracknameToFind as string) as integer
    idx = 0
    for each availTrack in m.view.availableSubtitleTracks
        ' The TrackName must contain the URL we supplied originally, though
        ' Roku mangles the name a bit, so we check if the URL is a substring, rather
        ' than strict equality
        if Instr(1, availTrack.TrackName, tracknameToFind)
            return idx
        end if
        idx = idx + 1
    end for
    return SubtitleSelection.NONE
end function

function audioMiniPlayerIsVisible(baseNode as dynamic) as boolean
    m.audioMiniPlayer = invalid

    scene = baseNode.getScene()
    if not isValid(scene) then return false

    m.audioMiniPlayer = scene.findNode("audioMiniPlayer")
    if not isValid(m.audioMiniPlayer) then return false

    return m.audioMiniPlayer.callFunc("isVisible")
end function

' onVoiceInputData: Called when VoiceInputTask receives a voice/transport command.
' Decodes the command, handles it, and sends EventResponse back to Roku OS.
'
sub onVoiceInputData()
    if not isValid(m.view) then return
    data = m.voiceInputTask.inputData
    if not isChainValid(data, "type") then return

    ret = handleTransportCommand(data)

    ' Send EventResponse back to Roku OS with the result
    if isChainValid(data, "id")
        m.voiceInputTask.transportResponse = { id: data.id, status: ret.status }
    end if

    ' Forward seek commands to VideoPlayerView
    if isValid(ret.cmd)
        m.view.voiceCommand = ret.cmd
    end if
end sub

' Forward Now Playing metadata from VideoPlayerView to VoiceInputTask.
' VoiceInputTask calls roAppManager on its own thread since it cannot be called from render thread.
sub onNowPlayingMetadata()
    if not isValid(m.voiceInputTask) then return
    m.voiceInputTask.nowPlayingData = m.view.nowPlayingMetadata
end sub

' handleTransportCommand: Decodes and handles a voice/transport command.
' Returns an assocarray with "status" and optionally "cmd" for VideoPlayerView.
' Status values follow Roku's EventResponse spec:
'   "success"   - command handled successfully
'   "unhandled" - command not handled, Roku OS will execute default behavior
'   "error.generic" - command not available in current context
'
function handleTransportCommand(data as object) as object
    ret = { status: TransportStatus.UNHANDLED }
    if not isValid(m.view) then return ret

    if isStringEqual(data.type, TransportCommand.SEEK)
        ret.cmd = { type: TransportCommand.SEEK, position: data.position }
        ret.status = TransportStatus.SUCCESS
        return ret
    end if

    if not isStringEqual(data.type, "transport") then return ret
    if not isChainValid(data, "command") then return ret

    cmd = LCase(data.command)

    if isStringEqual(cmd, TransportCommand.STARTOVER)
        ret.cmd = { type: TransportCommand.SEEK, position: 0 }
        ret.status = TransportStatus.SUCCESS

    else if isStringEqual(cmd, TransportCommand.SEEK)
        currentPos = m.view.position
        duration = Val(data.duration)
        newPos = currentPos + duration
        if isStringEqual(data.direction, "backward")
            newPos = currentPos - duration
        end if
        if newPos < 0
            newPos = 0
            ret.status = TransportStatus.SUCCESS_SEEK_START
        else if newPos > m.view.duration
            newPos = m.view.duration - 30
            ret.status = TransportStatus.SUCCESS_SEEK_END
        else
            ret.status = TransportStatus.SUCCESS
        end if
        ret.cmd = { type: TransportCommand.SEEK, position: newPos }

    else if isStringEqual(cmd, TransportCommand.PLAY) or isStringEqual(cmd, TransportCommand.RESUME)
        ret.cmd = { type: TransportCommand.PLAY }
        ret.status = TransportStatus.SUCCESS

    else if isStringEqual(cmd, TransportCommand.PAUSE) or isStringEqual(cmd, TransportCommand.STOP)
        ret.cmd = { type: TransportCommand.PAUSE }
        ret.status = TransportStatus.SUCCESS

    else if isStringEqual(cmd, TransportCommand.PLAYPAUSE)
        ret.status = TransportStatus.SUCCESS

    else if isStringEqual(cmd, TransportCommand.FORWARD) or isStringEqual(cmd, TransportCommand.FASTFORWARD) or isStringEqual(cmd, TransportCommand.FF)
        if m.view.hasActiveSegment
            ret.cmd = { type: TransportCommand.SKIP }
            ret.status = TransportStatus.SUCCESS
        else
            ret.status = TransportStatus.UNHANDLED
        end if

    else if isStringEqual(cmd, TransportCommand.REWIND) or isStringEqual(cmd, TransportCommand.RW)
        ret.status = TransportStatus.UNHANDLED

    else if isStringEqual(cmd, TransportCommand.NEXT_ITEM)
        if m.view.hasActiveSegment
            ret.cmd = { type: TransportCommand.SKIP }
            ret.status = TransportStatus.SUCCESS
        else if m.global.queueManager.callFunc("getPosition") < m.global.queueManager.callFunc("getCount") - 1
            m.global.sceneManager.callFunc("clearPreviousScene")
            m.global.queueManager.callFunc("moveForward")
            m.global.queueManager.callFunc("playQueue")
            ret.status = TransportStatus.SUCCESS
        else
            ret.status = TransportStatus.ERROR_GENERIC
        end if

    else if isStringEqual(cmd, TransportCommand.REPLAY)
        ret.status = TransportStatus.UNHANDLED

    else if isStringEqual(cmd, TransportCommand.NOWPLAYING)
        ' Metadata was already sent to Roku OS when playback started in VideoPlayerView.
        currentItem = m.global.queueManager.callFunc("getCurrentItem")
        if isValid(currentItem)
            ret.status = TransportStatus.SUCCESS
        else
            ret.status = TransportStatus.ERROR_GENERIC
        end if

    else if isStringEqual(cmd, TransportCommand.SKIP)
        ret.cmd = { type: TransportCommand.SKIP }
        ret.status = TransportStatus.SUCCESS

    else if isStringEqual(cmd, TransportCommand.LOOP)
        ret.status = TransportStatus.UNHANDLED

    else if isStringEqual(cmd, TransportCommand.SHUFFLE)
        ret.status = TransportStatus.UNHANDLED

    else if isStringEqual(cmd, TransportCommand.LIKE)
        ret.status = TransportStatus.UNHANDLED

    else if isStringEqual(cmd, TransportCommand.DISLIKE)
        ret.status = TransportStatus.UNHANDLED

    else if isStringEqual(cmd, TransportCommand.STOP)
        ret.status = TransportStatus.UNHANDLED

    else if isStringEqual(cmd, TransportCommand.RESUME)
        ret.status = TransportStatus.UNHANDLED

    else if isStringEqual(cmd, TransportCommand.OK)
        ret.status = TransportStatus.UNHANDLED

    end if

    return ret
end function

    if not favoriteSectionExists()
        nextUpRow = m.top.content.CreateChild("HomeRow")
        nextUpRow.title = sectionName
        nextUpRow.imageWidth = getPosterSize(false)[0]
        nextUpRow.cursorSize = getPosterSize(false)
    end if

    ' Load the Favorites Data (lazy task creation)
    task = getOrCreateTask("favorites")
    task.observeField("content", "updateFavoritesItems")
    task.control = "RUN"
end sub

' updateHomeRows: Update function exposed to outside components
'
sub updateHomeRows()
    ' Hide the row counter to prevent flicker. We'll show it once loading timer fires
    m.top.showRowCounter = [false]
    processUserSections()
end sub

sub reloadFavorites()
    if not favoriteSectionExists() then return

    m.favoriteFocusForRefresh = getFavoriteFocusState()
    m.favoritesReloadOnly = true
    m.LoadFavoritesTask.observeField("content", "updateFavoritesItems")
    m.LoadFavoritesTask.control = TaskControl.RUN
end sub

' updateFavoritesItems: Processes LoadFavoritesTask content. Removes, Creates, or Updates favorites row as needed
'
sub updateFavoritesItems()
    m.processedRowCount++
    itemData = getTaskContentAndCleanup("favorites")

    insertIndex = getFirstFavoriteSectionIndex()

    if not isValidAndNotEmpty(itemData)
        removeHomeSection(sectionName)
        return
    end if

    ' remake row using the new data
    row = CreateObject("roSGNode", "HomeRow")
    row.title = sectionName
    row.imageWidth = getPosterSize(false)[0]
    row.cursorSize = getPosterSize(false)

    for each item in itemData
        usePoster = true

        if lcase(item.type) = "episode" or lcase(item.type) = "audio" or lcase(item.type) = "musicartist"
            usePoster = false
        end if

        item.usePoster = usePoster
        item.imageWidth = row.imageWidth
        row.appendChild(item)
    end for

    if sectionExists(sectionName)
        m.top.content.replaceChild(row, getSectionIndex(sectionName))
        setRowItemSize()
        return
    end if

    activeFavoriteTitles = {}
    for each favoriteRowData in favoriteRows
        rowTitle = favoriteRowData.LookupCI("title")
        row = invalid
        currentIndex = getFavoriteSectionIndexByTitle(rowTitle)

        if currentIndex >= 0
            row = m.top.content.getChild(currentIndex)
            if favoriteRowItemsMatch(row, favoriteRowData)
                updateFavoriteRowMetadata(row, favoriteRowData)
            else
                updateFavoriteRowFromData(row, favoriteRowData)
            end if

            if currentIndex <> insertIndex
                m.top.content.removeChildIndex(currentIndex)
                if currentIndex < insertIndex then insertIndex--
                m.top.content.insertChild(row, insertIndex)
            end if
        else
            row = createFavoriteRowFromData(favoriteRowData)
            if isValid(row)
                m.top.content.insertChild(row, insertIndex)
            end if
        end if

        if isValid(row)
            activeFavoriteTitles[normalizeSectionTitle(rowTitle)] = true
            insertIndex++
        end if
    end for

    removeFavoriteSectionsExcept(activeFavoriteTitles)
    setRowItemSize()
end sub

' createFavoriteRowFromData: Creates a HomeRow for one type-specific Favorites group
'
function createFavoriteRowFromData(rowData as object) as object
    if not isChainValid(rowData, "items") or not isValidAndNotEmpty(rowData.items) then return invalid

    rowType = rowData.LookupCI("rowType") ?? "wide"
    rowSize = getFavoriteRowItemSize(rowType)

    row = CreateObject("roSGNode", "HomeRow")
    row.title = rowData.LookupCI("title")
    row.imageWidth = rowSize[0]
    row.cursorSize = rowSize

    for each item in rowData.items
        item.usePoster = isStringEqual(rowType, "poster")
        item.imageWidth = row.imageWidth
        row.appendChild(item)
    end for

    return row
end function

sub updateFavoriteRowMetadata(row as object, rowData as object)
    if not isValid(row) then return

    rowType = rowData.LookupCI("rowType") ?? "wide"
    rowSize = getFavoriteRowItemSize(rowType)

    row.title = rowData.LookupCI("title")
    row.imageWidth = rowSize[0]
    row.cursorSize = rowSize

    for each item in row.getChildren(-1, 0)
        item.usePoster = isStringEqual(rowType, "poster")
        item.imageWidth = row.imageWidth
    end for
end sub

sub updateFavoriteRowFromData(row as object, rowData as object)
    if not isValid(row) then return
    if not isValidAndNotEmpty(chainLookupReturn(rowData, "items", [])) then return

    rowType = rowData.LookupCI("rowType") ?? "wide"
    rowSize = getFavoriteRowItemSize(rowType)

    row.title = rowData.LookupCI("title")
    row.imageWidth = rowSize[0]
    row.cursorSize = rowSize

    if row.getChildCount() > 0
        row.removeChildrenIndex(row.getChildCount(), 0)
    end if

    for each item in rowData.items
        item.usePoster = isStringEqual(rowType, "poster")
        item.imageWidth = row.imageWidth
        row.appendChild(item)
    end for
end sub

function favoriteRowItemsMatch(row as object, rowData as object) as boolean
    if not isValid(row) then return false
    if not isValidAndNotEmpty(chainLookupReturn(rowData, "items", [])) then return false
    if row.getChildCount() <> rowData.items.count() then return false

    for i = 0 to rowData.items.count() - 1
        if not isStringEqual(getFavoriteItemId(row.getChild(i)), getFavoriteItemId(rowData.items[i]))
            return false
        end if
    end for

    return true
end function

function getFavoriteItemId(item as dynamic) as dynamic
    if not isValid(item) then return invalid

    itemId = item.LookupCI("id")
    if isValidAndNotEmpty(itemId) then return itemId

    itemJson = item.LookupCI("json")
    if isValid(itemJson)
        return itemJson.LookupCI("id")
    end if

    return invalid
end function

function getFavoriteRowItemSize(rowType as string) as object
    if isStringEqual(rowType, "poster") then return homeRowItemSizes.MOVIE_POSTER
    if isStringEqual(rowType, "album") then return homeRowItemSizes.MUSIC_ALBUM
    return homeRowItemSizes.WIDE_POSTER
end function

' isFavoriteSectionTitle: Matches the placeholder Favorites row and translated split Favorites rows
'
function isFavoriteSectionTitle(sectionTitle as dynamic) as boolean
    if not isValid(sectionTitle) then return false

    searchSectionTitle = normalizeSectionTitle(sectionTitle)
    favoritesTitle = tr("Favorites").Replace(" ", String.EMPTY)
    favoriteTitlePrefix = tr("Favorite").Replace(" ", String.EMPTY)

    return isStringEqual(searchSectionTitle, favoritesTitle) or searchSectionTitle.StartsWith(favoriteTitlePrefix)
end function

function normalizeSectionTitle(sectionTitle as dynamic) as string
    if not isValid(sectionTitle) then return String.EMPTY

    return sectionTitle.Replace(" ", String.EMPTY)
end function

function favoriteSectionExists() as boolean
    if not isValid(m.top.content) then return false

    homeSections = m.top.content.getChildren(-1, 0)
    for each section in homeSections
        if isFavoriteSectionTitle(section.title) then return true
    end for

    return false
end function

function isFocusOnFavoriteRow() as boolean
    rowItemFocused = chainLookupReturn(m.top, "rowItemFocused", invalid)
    if not isValidAndNotEmpty(rowItemFocused) then return false
    if not isValid(m.top.content) then return false

    focusedRow = m.top.content.getChild(rowItemFocused[0])
    if not isValid(focusedRow) then return false

    return isFavoriteSectionTitle(focusedRow.title)
end function

sub restoreFavoriteFocusForRefresh()
    if not isValid(m.favoriteFocusForRefresh) then return
    if not isValid(m.top.content) then return

    targetIndex = getFavoriteSectionIndexByTitle(m.favoriteFocusForRefresh.rowTitle)
    if targetIndex < 0 then targetIndex = getExistingFavoriteSectionIndex()
    if targetIndex < 0
        m.favoriteFocusForRefresh = invalid
        return
    end if

    targetRow = m.top.content.getChild(targetIndex)
    if not isValid(targetRow) then return

    itemCount = targetRow.getChildCount()
    if itemCount = 0
        m.favoriteFocusForRefresh = invalid
        return
    end if

    column = getFavoriteItemIndexById(targetRow, m.favoriteFocusForRefresh.itemId)
    if column < 0 then column = m.favoriteFocusForRefresh.column
    if column >= itemCount then column = itemCount - 1
    if column < 0 then column = 0

    rowItemFocused = chainLookupReturn(m.top, "rowItemFocused", invalid)
    if isValidAndNotEmpty(rowItemFocused)
        if rowItemFocused[0] = targetIndex and rowItemFocused[1] = column
            m.favoriteFocusForRefresh = invalid
            return
        end if
    end if

    m.top.jumpToRowItem = [targetIndex, column]
    m.favoriteFocusForRefresh = invalid
end sub

function getFavoriteFocusState() as dynamic
    rowItemFocused = chainLookupReturn(m.top, "rowItemFocused", invalid)
    if not isValidAndNotEmpty(rowItemFocused) then return invalid
    if not isValid(m.top.content) then return invalid

    focusedRow = m.top.content.getChild(rowItemFocused[0])
    if not isValid(focusedRow) then return invalid
    if not isFavoriteSectionTitle(focusedRow.title) then return invalid

    focusedItem = focusedRow.getChild(rowItemFocused[1])

    return {
        rowTitle: focusedRow.title,
        itemId: getFavoriteItemId(focusedItem),
        column: rowItemFocused[1]
    }
end function

function getFavoriteItemIndexById(row as object, itemId as dynamic) as integer
    if not isValid(row) then return -1
    if not isValidAndNotEmpty(itemId) then return -1

    for i = 0 to row.getChildCount() - 1
        currentItemId = getFavoriteItemId(row.getChild(i))
        if isValidAndNotEmpty(currentItemId) and isStringEqual(currentItemId, itemId)
            return i
        end if
    end for

    return -1
end function

function getExistingFavoriteSectionIndex() as integer
    if not isValid(m.top.content) then return -1

    homeSections = m.top.content.getChildren(-1, 0)
    i = 0
    for each section in homeSections
        if isFavoriteSectionTitle(section.title) then return i
        i++
    end for

    return -1
end function

' cancelFavoriteFocusForNavigation: User input after returning should win over the async restore.
sub cancelFavoriteFocusForNavigation(key as string)
    if not isValid(m.favoriteFocusForRefresh) then return

    cancelKeyCodes = [KeyCode.LEFT, KeyCode.RIGHT, KeyCode.UP, KeyCode.DOWN, KeyCode.BACK, KeyCode.OK, KeyCode.PLAY, KeyCode.OPTIONS]
    if inArray(cancelKeyCodes, key)
        m.favoriteFocusForRefresh = invalid
    end if
end sub

' getFirstFavoriteSectionIndex: Preserves the configured Favorites placement when inserting split rows
'
function getFirstFavoriteSectionIndex() as integer
    if not isValid(m.top.content) then return getOriginalSectionIndex("favorites")

    homeSections = m.top.content.getChildren(-1, 0)
    i = 0
    for each section in homeSections
        if isFavoriteSectionTitle(section.title) then return i
        i++
    end for

    return getOriginalSectionIndex("favorites")
end function

function getFavoriteSectionIndexByTitle(sectionTitle as dynamic) as integer
    if not isValid(sectionTitle) then return -1
    if not isValid(m.top.content) then return -1

    searchSectionTitle = normalizeSectionTitle(sectionTitle)
    homeSections = m.top.content.getChildren(-1, 0)

    i = 0
    for each section in homeSections
        if isFavoriteSectionTitle(section.title) and isStringEqual(normalizeSectionTitle(section.title), searchSectionTitle)
            return i
        end if
        i++
    end for

    return -1
end function

sub removeFavoriteSections()
    if not isValid(m.top.content) then return

    homeSections = m.top.content.getChildren(-1, 0)
    if homeSections.count() = 0 then return

    for i = homeSections.count() - 1 to 0 step -1
        if isFavoriteSectionTitle(homeSections[i].title)
            m.top.content.removeChildIndex(i)
        end if
    end for
end sub

sub removeFavoriteSectionsExcept(sectionTitles as object)
    if not isValid(m.top.content) then return

    homeSections = m.top.content.getChildren(-1, 0)
    if homeSections.count() = 0 then return

    for i = homeSections.count() - 1 to 0 step -1
        sectionTitle = homeSections[i].title
        if isFavoriteSectionTitle(sectionTitle) and not sectionTitles.DoesExist(normalizeSectionTitle(sectionTitle))
            m.top.content.removeChildIndex(i)
        end if
    end for
end sub

' updateMyListItems: Processes LoadMyListTask content. Removes, Creates, or Updates My List row as needed
'
sub updateMyListItems()
    m.processedRowCount++
    itemData = getTaskContentAndCleanup("mylist")

    sectionName = tr("My List")

    if not isValidAndNotEmpty(itemData)
        removeHomeSection(sectionName)
        return
    end if

    ' remake row using the new data
    row = CreateObject("roSGNode", "HomeRow")
    row.title = sectionName
    row.imageWidth = getPosterSize(false)[0]
    row.cursorSize = getPosterSize(false)

    for each item in itemData
        usePoster = true

        if lcase(item.type) = "episode" or lcase(item.type) = "audio" or lcase(item.type) = "musicartist"
            usePoster = false
        end if

        item.usePoster = usePoster
        item.imageWidth = row.imageWidth
        row.appendChild(item)
    end for

    if sectionExists(sectionName)
        m.top.content.replaceChild(row, getSectionIndex(sectionName))
        setRowItemSize()
        return
    end if

    m.top.content.insertChild(row, getSectionIndex(sectionName))
    setRowItemSize()
end sub

' updateContinueWatchingItems: Processes LoadContinueWatchingTask content. Removes, Creates, or Updates continue watching row as needed
'
sub updateContinueWatchingItems()
    m.processedRowCount++
    itemData = getTaskContentAndCleanup("continue")

    sectionName = tr("Continue Watching")

    if not isValidAndNotEmpty(itemData)
        removeHomeSection(sectionName)
        return
    end if

    ' remake row using the new data
    row = CreateObject("roSGNode", "HomeRow")
    row.title = sectionName

    ' Determine whether to use posters or thumbnails based on preference
    preferThumbnails = chainLookupReturn(m.global.session, "user.settings.ui.home.preferThumbnails", false)
    row.usePoster = not preferThumbnails ' Use thumbnails when prefer thumbnails is enabled

    ' Set sizes: wide if thumbnails, portrait if posters
    if preferThumbnails
        row.imageWidth = homeRowItemSizes.WIDE_POSTER[0]
        row.cursorSize = homeRowItemSizes.WIDE_POSTER
    else
        row.imageWidth = homeRowItemSizes.MOVIE_POSTER[0]
        row.cursorSize = homeRowItemSizes.MOVIE_POSTER
    end if

    for each item in itemData
        if isChainValid(item, "json.UserData.PlayedPercentage")
            item.PlayedPercentage = item.json.UserData.PlayedPercentage
        end if

        item.usePoster = row.usePoster
        item.imageWidth = row.imageWidth
        row.appendChild(item)
    end for

    ' Row already exists, replace it with new content
    if sectionExists(sectionName)
        m.top.content.replaceChild(row, getSectionIndex(sectionName))
        setRowItemSize()
        return
    end if

    ' Row does not exist, insert it into the home view
    m.top.content.insertChild(row, getOriginalSectionIndex("resume"))
    setRowItemSize()
end sub


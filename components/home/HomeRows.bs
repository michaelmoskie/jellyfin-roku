' createRadioStationsRow: Creates a row displaying radio stations
'
sub createRadioStationsRow()
    m.processedRowCount++
    sectionName = tr("Radio Stations")
    row = m.top.content.CreateChild("HomeRow")
    row.title = sectionName
    row.imageWidth = homeRowItemSizes.MUSIC_ALBUM[0]
    row.cursorSize = homeRowItemSizes.MUSIC_ALBUM

    radioStationList = getListOfRadioStations()

    radioStationList.push({
        id: "createstation",
        backgroundColor: ColorPalette.TRIADBLUE,
        posterURL: "pkg:/images/icons/leastplayed.png",
        name: tr("Create Station"),
        subtitle: tr("Choose options for a new radio station"),
        action: "createstation"
    })

    for each station in radioStationList
        item = CreateObject("roSGNode", "HomeData")
        item.id = station.LookupCI("id")
        item.posterURL = station.LookupCI("posterURL")
        item.type = ItemType.RADIOSTATION
        item.usePoster = false
        item.imageWidth = row.imageWidth
        item.json = {
            id: station.LookupCI("id"),
            PlaylistID: station.LookupCI("id"),
            IsFolder: true,
            Name: station.LookupCI("name"),
            BackgroundColor: station.LookupCI("backgroundColor"),
            Subtitle: station.LookupCI("subtitle"),
            Type: ItemType.RADIOSTATION,
            CollectionType: "radioStation",
            sortBy: station.LookupCI("sortBy"),
            sortOrder: station.LookupCI("sortOrder"),
            limit: station.LookupCI("limit"),
            filters: station.LookupCI("filters"),
            action: station.LookupCI("action")
        }

        row.appendChild(item)
    end for

    if sectionExists(sectionName)
        m.top.content.replaceChild(row, getSectionIndex(sectionName))
        setRowItemSize()
        return
    end if

    m.top.content.insertChild(row, getSectionIndex(sectionName))
    setRowItemSize()
end sub

' createMyListRow: Creates a row displaying items from the user's personal list
'
sub createMyListRow()
    sectionName = tr("My List")

    if not sectionExists(sectionName)
        nextUpRow = m.top.content.CreateChild("HomeRow")
        nextUpRow.title = sectionName
        nextUpRow.imageWidth = getPosterSize(false)[0]
        nextUpRow.cursorSize = getPosterSize(false)
    end if

    ' Load the My List Data (lazy task creation)
    task = getOrCreateTask("mylist")
    task.observeField("content", "updateMyListItems")
    task.control = "RUN"
end sub

' createFavoritesRow: Creates a row displaying items from the user's favorites list
'
sub createFavoritesRow()
